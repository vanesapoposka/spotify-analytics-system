# Postgres connection — used by docker-compose.yml AND by every Python/psql
# script in this project (via etl/db_config.py). Change these if you point
# the project at a different Postgres instance (cloud, existing local install, etc).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=spotify_dwh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
